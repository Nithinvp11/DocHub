{
  "name": "repo-aware-knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=12288 --expose-gc node_modules/next/dist/bin/next dev",
    "dev:next": "next dev",
    "build": "npm run db:generate && next build",
    "start": "NODE_ENV=production node --max-old-space-size=12288 --expose-gc node_modules/next/dist/bin/next start",
    "start:next": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "debug:permission-audit": "tsx scripts/dev/permission-system-debug.ts",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
